<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header" role="banner">
  <div class="container container-wide site-header__inner">
    <a class="brand" href="{{ site.url }}/" aria-label="{{ site.name }} — home">
      <span class="brand__mark" aria-hidden="true">
        <img src="/assets/img/logo.svg" alt="" width="36" height="36" loading="eager"/>
      </span>
      <span class="brand__text">
        <span class="brand__title">Spatial LLM</span>
        <span class="brand__sub">&amp; AI Agent Workflows</span>
      </span>
    </a>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        <li>
          <a href="{{ site.url }}/" {% if page.url == "/" %}aria-current="page"{% endif %}>
            {% set name = "home" %}{% set size = 18 %}{% include "icon.njk" %}
            <span>Home</span>
          </a>
        </li>
        {% for section in collections.topics %}
        {% set kids = section | children(collections.articles) %}
        <li class="nav-item{% if kids.length %} nav-item--has-panel{% endif %}">
          <a href="{{ site.url }}{{ section.url }}" {% if page.url.startsWith(section.url) %}aria-current="page"{% endif %}>
            {% set name = section.data.icon or "compass" %}{% set size = 18 %}{% include "icon.njk" %}
            <span>{{ section.data.navLabel or section.data.breadcrumb or section.data.title }}</span>
          </a>
          {% if kids.length %}
          <button type="button" class="nav-panel-toggle" aria-expanded="false"
                  aria-controls="nav-panel-{{ loop.index }}"
                  aria-label="Show topics in {{ section.data.navLabel or section.data.title }}">
            {% set name = "chevron" %}{% set size = 14 %}{% include "icon.njk" %}
          </button>
          <div class="nav-panel" id="nav-panel-{{ loop.index }}" hidden>
            <p class="nav-panel__head">{{ kids.length }} topics in {{ section.data.navLabel or section.data.title }}</p>
            <ul class="nav-panel__list">
              {% for kid in kids %}
              <li><a href="{{ site.url }}{{ kid.url }}">{{ kid.data.breadcrumb or kid.data.title }}</a></li>
              {% endfor %}
            </ul>
            <a class="nav-panel__all" href="{{ site.url }}{{ section.url }}">Open the section <span aria-hidden="true">&rarr;</span></a>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
        {% set name = "moon" %}{% set size = 19 %}{% include "icon.njk" %}
        {% set name = "sun" %}{% set size = 19 %}{% include "icon.njk" %}
      </button>

      <button type="button" class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
        {% set name = "menu" %}{% set size = 22 %}{% include "icon.njk" %}
        {% set name = "close" %}{% set size = 22 %}{% include "icon.njk" %}
      </button>
    </div>
  </div>
</header>
